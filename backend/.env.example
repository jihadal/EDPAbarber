# =====================================================
# EDPAbarber — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =====================================================

# ── Server ─────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000

# ── Database (MySQL / XAMPP) ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=edpabarber_db

# ── JWT ─────────────────────────────────────────────
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# ── CORS ─────────────────────────────────────────────
# Set to your frontend origin in production
CORS_ORIGIN=http://localhost:3000

# ── Midtrans Payment Gateway ─────────────────────────
# Get credentials at: https://dashboard.midtrans.com
# Sandbox keys start with "SB-" prefix.
#
# MIDTRANS_ENV = sandbox  (default)  OR  production
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key

# ── WhatsApp (for confirmation button) ───────────────
# International format without +, e.g. 6281200000000
WHATSAPP_NUMBER=62895415418661
